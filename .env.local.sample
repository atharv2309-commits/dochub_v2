NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical origin for sitemap/OG/canonical URLs. Defaults to localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=

GITBOOK_API_TOKEN=
GITBOOK_SPACE_ID=
SUPABASE_SERVICE_ROLE_KEY=

# Background translation worker auth (also set this in Vercel env)
TRANSLATION_WORKER_SECRET=

# "Ask AI" (gpt-4o-mini via @ai-sdk/openai)
OPENAI_API_KEY=

# GitHub sync (Docs/Releases projects)
GITHUB_SYNC_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Analytics digest ("Ask AI"-style synthesis via gemini-2.5-flash / @ai-sdk/google)
GEMINI_API_KEY=

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Blank = GA4 script never loads (no error).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Analytics insights worker auth (also set this in Vercel env)
ANALYTICS_WORKER_SECRET=
